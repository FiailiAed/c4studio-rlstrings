---
interface Props {
  title?: string;
}

const { title = 'Developer Tools | RL Strings' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="h-full bg-gray-950">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body class="h-full text-white">
    <!-- Simple dark header -->
    <header class="bg-gray-900 border-b border-white/10">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex h-14 items-center justify-between">
          <div class="flex items-center gap-3">
            <span class="text-sm font-semibold text-white">RL Strings — Developer Tools</span>
            <span class="inline-flex items-center rounded-full bg-amber-500/20 px-2 py-0.5 text-xs font-bold text-amber-300 ring-1 ring-amber-500/30">
              DEV
            </span>
          </div>
          <a
            href="/admin"
            class="text-xs text-gray-400 hover:text-white transition-colors"
          >
            &larr; Back to Admin
          </a>
        </div>
      </div>
    </header>

    <!-- Main content -->
    <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <slot />
    </main>
  </body>
</html>
