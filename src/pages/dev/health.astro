---
import DevLayout from '../../layouts/DevLayout.astro';
import HealthDashboard from '../../components/HealthDashboard';
import { getAllHealthStatus } from '../../lib/health-checks';

const auth = Astro.locals.auth();
const { userId } = auth;
if (!userId) return Astro.redirect('/admin/sign-in');

const healthStatus = await getAllHealthStatus(userId);
---

<DevLayout title="Site Health | RL Strings Dev">
  <!-- Header -->
  <div class="mb-8">
    <h1 class="text-2xl font-bold text-white">Site Health</h1>
    <p class="text-gray-400 text-sm mt-1">Real-time monitoring of all external services and infrastructure</p>
  </div>

  <!-- Health Dashboard React Component -->
  <HealthDashboard client:load initialStatus={healthStatus} />
</DevLayout>
