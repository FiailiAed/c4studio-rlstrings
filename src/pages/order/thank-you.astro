---
export const prerender = false;
import ShopLayout from '../../layouts/ShopLayout.astro';

const sessionId = Astro.url.searchParams.get('session_id');
const codeParam = Astro.url.searchParams.get('code');

if (!sessionId || !codeParam) {
  return Astro.redirect('/');
}

const stripeKey = import.meta.env.STRIPE_SECRET_KEY;

type StripeLineItem = {
  description: string;
  quantity: number;
  amount_total: number;
};

type StripeSession = {
  metadata: { pickupCode?: string };
  customer_details: { name: string | null; email: string | null };
  amount_total: number | null;
  line_items: { data: StripeLineItem[] };
};

let session: StripeSession | null = null;
let fetchError = false;

try {
  const url = `https://api.stripe.com/v1/checkout/sessions/${sessionId}?expand[]=line_items&expand[]=customer_details`;
  const res = await fetch(url, {
    headers: { Authorization: `Bearer ${stripeKey}` },
  });
  if (!res.ok) {
    fetchError = true;
  } else {
    session = await res.json() as StripeSession;
  }
} catch {
  fetchError = true;
}

const pickupCode = session?.metadata?.pickupCode ?? codeParam;
const customerName = session?.customer_details?.name ?? null;
const customerEmail = session?.customer_details?.email ?? null;
const amountTotal = session?.amount_total ?? null;
const lineItems: StripeLineItem[] = session?.line_items?.data ?? [];

function formatCents(cents: number): string {
  return `$${(cents / 100).toFixed(2)}`;
}
---

<ShopLayout
  title={`Order Confirmed | RL Strings`}
  description="Thank you for your order. Here's a summary of what you purchased."
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16">

    {fetchError ? (
      <!-- Error State -->
      <div class="bg-red-50 border border-red-200 rounded-xl p-8 text-center">
        <div class="text-red-500 text-4xl mb-4">⚠</div>
        <h1 class="text-xl font-bold text-slate-900 mb-2">Could not load order details</h1>
        <p class="text-slate-600 mb-6">
          Your payment was processed, but we couldn't retrieve your order summary. Please contact support with your pickup code.
        </p>
        <div class="bg-white border border-red-200 rounded-lg px-6 py-4 inline-block mb-6">
          <p class="text-xs text-slate-500 uppercase tracking-widest mb-1">Your Pickup Code</p>
          <p class="text-4xl font-black tracking-widest text-slate-900">{pickupCode}</p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a
            href={`/order/${pickupCode}`}
            class="inline-flex items-center justify-center px-6 py-3 rounded-lg bg-indigo-600 text-white font-semibold hover:bg-indigo-500 transition-colors"
          >
            Track Your Order &rarr;
          </a>
          <a
            href="mailto:todd@rlstrings.com"
            class="inline-flex items-center justify-center px-6 py-3 rounded-lg border border-slate-300 text-slate-700 font-semibold hover:bg-slate-50 transition-colors"
          >
            Contact Support
          </a>
        </div>
      </div>
    ) : (
      <>
        <!-- Success Banner -->
        <div class="text-center mb-10">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-green-100 mb-4">
            <svg class="w-8 h-8 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <h1 class="text-3xl font-bold tracking-tight text-slate-900">Order Confirmed!</h1>
          <p class="mt-2 text-slate-500">
            {customerName ? `Thanks, ${customerName}!` : 'Thank you for your order!'} We'll get to work on your custom pocket.
          </p>
        </div>

        <!-- Pickup Code -->
        <div class="bg-indigo-50 border-2 border-indigo-200 rounded-2xl p-8 text-center mb-8">
          <p class="text-xs font-bold uppercase tracking-widest text-indigo-500 mb-2">Your Pickup Code</p>
          <p class="text-6xl font-black tracking-[0.3em] text-slate-900 mb-3">{pickupCode}</p>
          <p class="text-sm text-slate-500">Save this code — you'll need it to drop off your head and track your order.</p>
        </div>

        <!-- Order Summary -->
        <div class="bg-white border border-slate-200 rounded-xl overflow-hidden mb-8">
          <div class="px-6 py-4 border-b border-slate-100">
            <h2 class="text-base font-semibold text-slate-900">Order Summary</h2>
          </div>
          <div class="divide-y divide-slate-100">
            {lineItems.length > 0 ? (
              lineItems.map((item) => (
                <div class="flex items-center justify-between px-6 py-4">
                  <div>
                    <p class="text-sm font-medium text-slate-900">{item.description}</p>
                    {item.quantity > 1 && (
                      <p class="text-xs text-slate-400">Qty: {item.quantity}</p>
                    )}
                  </div>
                  <p class="text-sm font-semibold text-slate-900">{formatCents(item.amount_total)}</p>
                </div>
              ))
            ) : (
              <div class="px-6 py-4">
                <p class="text-sm text-slate-400">No line item details available.</p>
              </div>
            )}
          </div>
          {amountTotal !== null && (
            <div class="flex items-center justify-between px-6 py-4 bg-slate-50 border-t border-slate-200">
              <span class="text-sm font-semibold text-slate-900">Order Total</span>
              <span class="text-lg font-bold text-indigo-600">{formatCents(amountTotal)}</span>
            </div>
          )}
        </div>

        <!-- Customer Info -->
        {(customerName || customerEmail) && (
          <div class="bg-white border border-slate-200 rounded-xl px-6 py-5 mb-8">
            <h2 class="text-sm font-semibold text-slate-900 mb-3">Confirmation sent to</h2>
            {customerName && <p class="text-sm text-slate-700 font-medium">{customerName}</p>}
            {customerEmail && <p class="text-sm text-slate-500">{customerEmail}</p>}
          </div>
        )}

        <!-- Next Steps -->
        <div class="bg-white border border-slate-200 rounded-xl px-6 py-6 mb-8">
          <h2 class="text-sm font-semibold text-slate-900 mb-5">What happens next?</h2>
          <ol class="relative border-l border-slate-200 ml-3 space-y-6">
            <li class="pl-6">
              <div class="absolute w-2.5 h-2.5 bg-indigo-600 rounded-full -left-[5px] mt-0.5 border-2 border-white"></div>
              <p class="text-sm font-semibold text-slate-900">Drop off your unstrung head</p>
              <p class="text-xs text-slate-500 mt-1">
                Bring your head to <span class="font-medium text-slate-700">Stellar Athletics, 876 N Lenola Rd, Moorestown, NJ</span>. Tape your name and pickup code <strong>{pickupCode}</strong> to the shaft.
              </p>
            </li>
            <li class="pl-6">
              <div class="absolute w-2.5 h-2.5 bg-slate-300 rounded-full -left-[5px] mt-0.5 border-2 border-white"></div>
              <p class="text-sm font-semibold text-slate-500">Todd gets to work</p>
              <p class="text-xs text-slate-500 mt-1">Your custom pocket will be strung to your exact spec.</p>
            </li>
            <li class="pl-6">
              <div class="absolute w-2.5 h-2.5 bg-slate-300 rounded-full -left-[5px] mt-0.5 border-2 border-white"></div>
              <p class="text-sm font-semibold text-slate-500">You'll be notified when it's ready</p>
              <p class="text-xs text-slate-500 mt-1">We'll reach out when your order is complete and ready for pickup.</p>
            </li>
          </ol>
        </div>

        <!-- CTA -->
        <div class="text-center">
          <a
            href={`/order/${pickupCode}`}
            class="inline-flex items-center justify-center px-8 py-3 rounded-xl bg-indigo-600 text-white font-semibold hover:bg-indigo-500 transition-colors shadow-sm"
          >
            Track Your Order &rarr;
          </a>
        </div>
      </>
    )}

  </div>
</ShopLayout>
